# Copia este archivo como backend/.env y completa los valores.
# El servidor NO arranca si falta una variable obligatoria o es inválida.

# --- Base de datos (Supabase → Project Settings → Database) ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- JWT ---
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración del token: <número><s|m|h|d>
JWT_EXPIRES_IN=2h

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma, sin "/" final
CORS_ORIGIN=http://localhost:4200
# false en local; número de proxies delante en producción (p. ej. 1 detrás de Nginx/Render)
TRUST_PROXY=false
# Peticiones máximas por IP cada 15 minutos en /api
RATE_LIMIT_API=500
