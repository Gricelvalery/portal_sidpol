# Copia este archivo como backend/.env y completa los valores.
# El servidor NO arranca si falta una variable obligatoria o es inválida.

# --- Base de datos (Supabase → Project Settings → Database) ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- JWT ---
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración del token: <número><s|m|h|d>
JWT_EXPIRES_IN=2h

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma, sin "/" final
CORS_ORIGIN=http://localhost:4200
# false en local; número de proxies delante en producción (p. ej. 1 detrás de Nginx/Render)
TRUST_PROXY=false
# Peticiones máximas por IP cada 15 minutos en /api
RATE_LIMIT_API=500
# Intentos fallidos de login por IP+usuario cada 15 minutos
RATE_LIMIT_LOGIN=5
# Costo de bcrypt (mínimo 12 en producción; las pruebas usan 4)
BCRYPT_COST=12
# Dominios permitidos para los links de dashboards (iframe del visor), separados por coma
POWERBI_HOSTS=app.powerbi.com
# Nivel de registro: fatal, error, warn, info, debug, trace o silent
LOG_LEVEL=info
# Swagger UI en /api/docs (por defecto: true salvo NODE_ENV=production)
DOCS_ENABLED=true
